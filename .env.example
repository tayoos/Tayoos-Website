REACT_APP_WEATHER_API_KEY=your_api_key_here

// npm run spotify:refresh
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_CLIENT_SECRET=
VITE_SPOTIFY_REFRESH_TOKEN=

VITE_APPLE_TEAM_ID=your_team_id
VITE_APPLE_KEY_ID=your_key_id
VITE_APPLE_PRIVATE_KEY=MIGTAgEAMBMG...your_base64_encoded_private_key...

// Contact form → admin.tayoos.com/api/contact/webhook
// Basic anti-scraper token. NOT a real secret — Vite bakes it into the client
// bundle so anyone reading the JS can see it. Rely on rate-limiting + honeypot
// on the receiving webhook for actual abuse prevention.
// Must match the value set as CONTACT_WEBHOOK_SECRET in the Tayoos-Admin app.
VITE_CONTACT_WEBHOOK_SECRET=set-me-to-the-value-in-tayoos-admin